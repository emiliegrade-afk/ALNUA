# Backend FastAPI (used by Next.js proxy only — not exposed to the browser).
HUB_API_BACKEND_URL=http://localhost:8000
# Must match HUB_API_KEY in the repo root .env.
HUB_API_KEY=
# Optional public URLs (defaults use the Next.js proxy).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/hub
NEXT_PUBLIC_AFFILIATE_BASE_URL=
# Décommenter quand UE5 + Nwiro actifs — doit matcher NWIRO_HOST:NWIRO_PORT du .env racine
# NEXT_PUBLIC_NWIRO_HOST=http://localhost:5353
NEXT_PUBLIC_NWIRO_HOST=
# Copy from SUPABASE_URL / SUPABASE_KEY in root .env (anon key for browser RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
