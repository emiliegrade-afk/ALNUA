# Copy these into Vercel → Project Settings → Environment Variables
# Project root directory must be set to: web

# Server-only — FastAPI origin (VPS / Railway / Render)
HUB_API_BACKEND_URL=https://api.alnua.com

# Must match HUB_API_KEY on the API server (.env.prod)
HUB_API_KEY=

# Browser uses same-origin proxy; set to your Vercel deployment URL + /api/hub
NEXT_PUBLIC_API_URL=https://app.alnua.com/api/hub

# Supabase (anon key — RLS in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional
NEXT_PUBLIC_AFFILIATE_BASE_URL=
NEXT_PUBLIC_NWIRO_HOST=
