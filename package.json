{
  "name": "alnua-hub",
  "private": true,
  "scripts": {
    "dev:api": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -Target api",
    "dev:web": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -Target web",
    "dev:status": "powershell -ExecutionPolicy Bypass -File scripts/dev_ports.ps1 -Action status",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev_ports.ps1 -Action stop",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "test": "pytest tests/ -v --tb=short",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:e2e:ui": "npm --prefix web run test:e2e:ui",
    "deploy:build-web": "npm --prefix web run build",
    "deploy:verify": "python scripts/verify_deploy.py",
    "deploy:activate-prod-flags": "python scripts/activate_prod_flags.py"
  }
}
