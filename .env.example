# LLM
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=openrouter/minimax/minimax-m1

# Telegram — Aria (COO)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=0
# Telegram — Nadia (secrétaire, bot @BotFather séparé)
TELEGRAM_SECRETARY_BOT_TOKEN=
TELEGRAM_SECRETARY_CHAT_ID=
TELEGRAM_SECRETARY_POLLING=0
TELEGRAM_SECRETARY_WEBHOOK_SECRET=

# GitHub — autonomous coding pipeline
GITHUB_TOKEN=
GITHUB_REPO=

GITHUB_REPO_ACADEMY=
REPO_PATH_ACADEMY=
GITHUB_REPO_RESONANCE=
REPO_PATH_RESONANCE=
GITHUB_REPO_GAMING=
REPO_PATH_GAMING=

# Autonomous coding — Hub Agent (Cursor-like). Model = Paramètres (/settings) per agent.
CODING_BACKEND=hub
# AIDER_MODEL=   # optional override if CODING_BACKEND=aider
CODING_AUTO_MERGE=false
CODING_ACADEMY_AUTO_MERGE=true
CODING_QA_REQUIRED=true
CODING_TIMEOUT_S=1800
CODING_MAX_PARALLEL=2

# Phase A isolation — locks + slots + integrator-only merge (DEC-022)
ISOLATION_ENABLED=1
ISOLATION_MAX_GLOBAL=8
ISOLATION_MAX_PER_REPO=2
ISOLATION_MAX_PER_AGENT=1
ISOLATION_LOCK_TTL_S=3600
ISOLATION_WAIT_S=30
ISOLATION_INTEGRATOR_ONLY_MERGE=1
ISOLATION_FIX_PIPELINE_MERGE=1

# Phase C Loop Engine — execute → evaluate → feedback → retry (DEC-024)
LOOP_MAX_ITERATIONS=3
LOOP_STRICT_MAX_ITERATIONS=2
LOOP_RETRY_SLEEP_S=0

# Phase D Review Chain — auto → board → policy → integrate (DEC-025)
REVIEW_CHAIN_STAGING_TRUST_MIN=0.70

# Phase E PermissionGuard — Capability Packs fail-closed (DEC-026)
PERMISSION_GUARD_ENABLED=1
# MCP clients (Cursor) : enforce packs when X-MCP-Agent / X-MCP-Client is set
PERMISSION_GUARD_MCP_ENABLED=1

# Phase F Context Engine — L1–L4 + collective promotion (DEC-027)
CONTEXT_ENGINE_ENABLED=1
COLLECTIVE_PROMOTE_MIN_AGENTS=3

# Hermes Agent — skills procéduraux (clone local, lecture seule)
HERMES_SKILLS_ROOT=C:\Dev\hermes-agent-main\skills

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
# Backend API — écritures (BOM, etc.). Ne jamais exposer au frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Hub
ENVIRONMENT=development
HUB_REPO_PATH=
# Demarrage rapide — services lourds (scheduler, scan repo) apres /health (supervisor force 1)
HUB_FAST_START=1
# BugWatchdog — set 0 during heavy coding nights to avoid starving the API thread pool
WATCHDOG_ENABLED=1
WATCHDOG_MAX_ATTEMPTS=3
# Required in every environment, including local dev — the API refuses to start
# without one (see DECISIONS.md DEC-.. / BUGS.md SEC-002). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_API_KEY=
JWT_SECRET=
# Multi-tenancy (Sprint 1) — default tenant when X-Tenant-ID header absent
DEFAULT_TENANT_ID=alnua_coo
# LLM cache (Sprint 2) — saves cost on deterministic calls (temp <= 0.1)
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL_S=3600
# OpenRouter prompt caching — static SYSTEM + tools paid once (DeepSeek/MiniMax/Claude)
OPENROUTER_PROMPT_CACHE_ENABLED=1
OPENROUTER_PROMPT_CACHE_TTL=1h
# Fail fast — avoid retry loops burning tokens on hung MCP/tool calls
LLM_HTTP_TIMEOUT_S=60
LLM_HTTP_TIMEOUT_LONG_S=120
LLM_MAX_ATTEMPTS_PER_MODEL=2
# Rate limiting (Sprint 1) — assistant/chat + API per IP
RATE_LIMIT_ENABLED=1
# Redis + RQ worker (Sprint 2 prod)
REDIS_URL=redis://localhost:6379
# S3 backup (Sprint 4 DR)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=alnua-hub/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Multi-worker deploy: set SCHEDULER_LEADER=0 on secondary uvicorn workers
SCHEDULER_LEADER=1

# Phase 39 / DEC-021 — idle agent work (plan 08:10 + interval drain)
IDLE_WORK_ENABLED=1
IDLE_DRAIN_INTERVAL_MIN=180
IDLE_MAX_ITEMS_PER_DRAIN=1
IDLE_DEFAULT_AUTONOMY_LEVEL=1
IDLE_DAILY_BUDGET_USD=10
# Force template L1 drafts when OpenRouter credits are empty (set 1 if no credits)
IDLE_OFFLINE_MODE=0
SCHEDULER_TIMEZONE=Europe/Paris
HUB_API_URL=http://localhost:8003

# n8n Cloud — Cursor MCP (.cursor/mcp.json) + copier dans n8n Settings → Variables
N8N_BASE_URL=https://alnua.app.n8n.cloud
N8N_MCP_TOKEN=
# Dans n8n Cloud → Settings → Variables (workflows orchestration) :
# HUB_API_URL=http://host.docker.internal:8003  (Hub local) ou URL publique déployée
# HUB_API_KEY=<même valeur que HUB_API_KEY ci-dessus>
TEST_COMMAND=pytest tests/ -v --tb=short && python scripts/run_rnd_tests.py

# Discord (legacy COO bot)
DISCORD_TOKEN=

# Discord Wyrdheim community bot (leave empty until bot is created)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Announcements channel ID — DISCORD_CHANNEL_ANNOUNCEMENTS or DISCORD_CHANNEL_ANNONCES
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_CHANNEL_ANNONCES=
DISCORD_CHANNEL_LORE=
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_DEVLOG=

# Steam (Phase 18, ROADMAP.md — leave empty until Wyrdheim has a real Steam page)
# STEAM_API_KEY : https://steamcommunity.com/dev/apikey
# STEAM_APP_ID  : App ID Steamworks une fois le jeu enregistré
# NB : le nombre de wishlists n'est pas exposé par une API publique Valve
# (accès Steamworks Partner requis, hors service simple) — seul le nombre de
# joueurs simultanés (GetNumberOfCurrentPlayers, public) est branché.
STEAM_API_KEY=
STEAM_APP_ID=

# Raspberry Pi robotics (DEC-018 — optional until hardware ready; agents use Hub SSH)
PI_HOST=
PI_USER=pi
PI_SSH_KEY=~/.ssh/id_ed25519

# Looking Glass holographic display
LOOKING_GLASS_HOST=

# App Store / Google Play reviews (reviews_bot)
APP_STORE_ID=
GOOGLE_PLAY_PACKAGE=

# UE5.8 studio — DEC-017 server + DEC-020 Claude Code agency on this PC
UE5_SERVER_URL=
# UE58_HOST=127.0.0.1
# UE58_PORT=8765
UE58_API_KEY=
# Local Unreal project (git repo) — agents run Claude Code here (worktree)
UE_PROJECT_PATH=
# REPO_PATH_GAMING=   # alias of UE_PROJECT_PATH
# GITHUB_REPO_GAMING=owner/wyrdheim   # optional PR target

# Nwiro UE5 MCP — LEGACY (DEC-017); do not extend
NWIRO_HOST=localhost
NWIRO_PORT=5353

# Review Board LLM debate (Vague 3 / Phase 32+) — off by default; structural gate stays
REVIEW_BOARD_LLM=

# Obsidian vault — lore/GDD source of truth (local PC)
# Prefer D: when Kingston SSD is mounted; fallback auto: C:\Dev\ObsidianVault
OBSIDIAN_VAULT_PATH=D:\ObsidianVault
# Local REST API plugin (optional — phase 5 Nadia RAG)
OBSIDIAN_API_PORT=27124
OBSIDIAN_API_KEY=
# Supabase gaming project slug for GDD chunk sync
OBSIDIAN_GAMING_PROJECT_SLUG=wyrdheim

# Frontend Next.js — copy to web/.env.local (see web/.env.example)
NEXT_PUBLIC_HUB_API_URL=http://localhost:8003
NEXT_PUBLIC_NWIRO_HOST=

# Dashboard (legacy)
VITE_API_URL=http://localhost:8003

# Optional — monitoring & portal
# Phase 3 — pages admin Hub (coûts, events, A/B)
ADMIN_COSTS_PAGE_ENABLED=1
ADMIN_EVENTS_PAGE_ENABLED=1
ADMIN_AB_TEST_PAGE_ENABLED=1
BRIEFING_COO_SECTION_ENABLED=1
GDD_MANAGER_ENABLED=1

SENTRY_DSN=
SENTRY_WEBHOOK_SECRET=
# Dev only — set to 1 to accept /webhook/sentry without HMAC (never in prod)
SENTRY_WEBHOOK_ALLOW_UNSIGNED=0
# JSON map Sentry project slug → hub repo slug (ex: resonance-mobile → resonance)
# SENTRY_REPO_MAP={"resonance-mobile":"resonance","resonance-api":"resonance","hub":"hub"}
SENTRY_AUTO_ISSUE=true
# Email destinataire alertes sécurité apps (sinon CEO_GMAIL)
SECURITY_ALERT_EMAIL=
TELEGRAM_WEBHOOK_SECRET=
PLAUSIBLE_API_KEY=
BETA_PORTAL_BASE_URL=http://localhost:3000

# Grounding DINO (brand kit)
GROUNDING_DINO_CONFIG_PATH=models/groundingdino/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS_PATH=models/groundingdino/groundingdino_swint_ogc.pth
GROUNDING_DINO_DEVICE=auto

# Composio — API Gateway OAuth 250+ apps
COMPOSIO_API_KEY=
# OAuth identity for CEO Gmail/Calendar (default: alnua_coo)
COMPOSIO_USER_ID=alnua_coo
# Gmail ALNUA que Nadia doit utiliser (OAuth Google)
CEO_GMAIL=alnua.global@gmail.com
# Revolut Business API (Grow+) — lecture dépenses pour Jules/Rémi, JAMAIS de paiement auto
