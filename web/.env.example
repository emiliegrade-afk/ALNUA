# ── ALNUA Hub frontend — copy to web/.env.local ─────────────────────────────
#
# Required for local dev (browser calls /api/hub → Next proxy → FastAPI):
#   1. HUB_API_BACKEND_URL → FastAPI origin (NOT /api/hub).
#   2. HUB_API_KEY → same value as repo root .env (recommended).
#      Optional in development: if unset, proxy forwards without X-Hub-Key
#      when the backend runs with ENVIRONMENT=development and no HUB_API_KEY.
#
# Example:
#   HUB_API_KEY=your-hub-key
#   HUB_API_BACKEND_URL=http://localhost:8000

# Backend FastAPI origin — used by the Next.js /api/hub proxy only (server-side).
# Production (Vercel): set to the public API URL — see deploy/vercel.env.example
HUB_API_BACKEND_URL=http://localhost:8000

# Must match HUB_API_KEY in the repo root .env.
HUB_API_KEY=

# Browser-facing API prefix (same-origin proxy). Do NOT use as HUB_API_BACKEND_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/hub
NEXT_PUBLIC_AFFILIATE_BASE_URL=

# Uncomment when UE5 + Nwiro are running — must match NWIRO_HOST:NWIRO_PORT in root .env
# NEXT_PUBLIC_NWIRO_HOST=http://localhost:5353
NEXT_PUBLIC_NWIRO_HOST=

# Copy from SUPABASE_URL / SUPABASE_KEY in root .env (anon key for browser RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
