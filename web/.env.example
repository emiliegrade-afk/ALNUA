# Backend FastAPI (used by Next.js proxy only — not exposed to the browser).
HUB_API_BACKEND_URL=http://localhost:8000
# Must match HUB_API_KEY in the repo root .env.
HUB_API_KEY=
# Copy from SUPABASE_URL / SUPABASE_KEY in root .env (anon key for browser RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
