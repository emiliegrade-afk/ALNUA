# Obsidian library note bodies — regenerated by
# scripts/export_library_to_vault.py (see vault/.../library/_index/RETENTION.md).
# Keep _index/ (TOPICS, RETENTION, docs) ; ignore per-bureau dump notes.
vault/obsidian/library/**
!vault/obsidian/library/_index/
!vault/obsidian/library/_index/**

