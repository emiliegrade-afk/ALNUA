# Copy to .env.prod on the VPS and fill all values.
ENVIRONMENT=production

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

HUB_REPO_PATH=/home/alnua/hub
HUB_API_KEY=
JWT_SECRET=
SCHEDULER_LEADER=1
SCHEDULER_TIMEZONE=Europe/Paris

# Public URLs (n8n workflows + portal links)
HUB_API_URL=https://api.alnua.com
BETA_PORTAL_BASE_URL=https://app.alnua.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=0
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_VOICE_REPLIES=0

SENTRY_DSN=
SENTRY_WEBHOOK_SECRET=
# Never set in production:
# SENTRY_WEBHOOK_ALLOW_UNSIGNED=1

GITHUB_TOKEN=
GITHUB_REPO=

# n8n Cloud — same HUB_API_KEY as above
N8N_BASE_URL=https://alnua.app.n8n.cloud

# Phase 1–3 feature flags (enable gradually in prod)
ADMIN_COSTS_PAGE_ENABLED=1
ADMIN_EVENTS_PAGE_ENABLED=1
ADMIN_AB_TEST_PAGE_ENABLED=1
BRIEFING_COO_SECTION_ENABLED=1
GDD_MANAGER_ENABLED=1

# Phase 0 migration (safe defaults — change only when validated)
# COSTS_UNIFIED_READ=0
# COSTS_SHADOW_COMPARE=1
# BRIEFING_UNIFIED_GENERATE=0
